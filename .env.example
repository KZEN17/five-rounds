# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these per environment (Development / Preview / Production).

# --- Database ---
# Neon adds DATABASE_URL when you connect it from the Vercel Marketplace.
# Locally you can use an in-process Postgres instead: pglite://.pglite (a folder) or pglite://memory.
DATABASE_URL=pglite://.pglite

# --- Auth (Better Auth) ---
# Long random string, e.g. `openssl rand -base64 32`. Required in production.
AUTH_SECRET=
# Optional. Defaults to the Vercel branch/production URL, or http://localhost:3000 locally.
AUTH_URL=
# Magic-link email via Resend. Without a key, development prints the link in the terminal.
AUTH_RESEND_KEY=
# Sender, on a domain verified in Resend, e.g. "Five Rounds <signin@yourdomain.com>".
EMAIL_FROM=
# Google sign-in (optional). Redirect URI: <app URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# open = anyone 18+ can sign up; invite = only emails in the invites table (and OWNER_EMAIL).
SIGNUP_MODE=open
# The owner's account: always allowed to sign up, and the target of the legacy data import.
OWNER_EMAIL=

# --- Upstash Redis (already set on the Vercel project) ---
# Any Vercel prefix works (KV_REST_API_URL, UPSTASH_REDIS_REST_URL, STORAGE_KV_REST_API_URL, ...).
KV_REST_API_URL=
KV_REST_API_TOKEN=
